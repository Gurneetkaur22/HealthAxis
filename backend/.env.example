# Use DATABASE_URL (Neon connection string) OR individual vars below
DATABASE_URL=postgresql://user:password@host/dbname

# Individual vars (used for local dev if DATABASE_URL not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hospital_db
DB_USER=postgres
DB_PASSWORD=your_password

JWT_SECRET=your_super_secret_key_min_32_chars
JWT_EXPIRES_IN=7d
CLIENT_URL=https://your-frontend.vercel.app
NODE_ENV=production
PORT=5000
